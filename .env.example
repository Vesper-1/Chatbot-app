# =============================================================================
# AI CHAT APP - ENVIRONMENT VARIABLES (CLASSROOM DEMO)
# =============================================================================
# Instructions:
# 1. Copy this file and rename it to ".env" (without the .example)
# 2. Fill in your actual API keys below
# 3. Never commit the .env file to git (it should be in .gitignore)
# =============================================================================

# Flask Secret Key - Used to encrypt session cookies
# Generate a random string for production (this is just a demo)
SECRET_KEY=your-super-secret-key-change-this

# OpenAI API Key - For GPT models
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Google Gemini API Key - For Gemini models
# Get yours at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here

# DeepSeek API Key - For DeepSeek models
# Get yours at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-key-here
